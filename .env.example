# --- Supabase (leave empty to run with the in-memory store for local demos/tests) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose. Used for all DB access (hidden worlds live behind it).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Instructor authentication ---
INSTRUCTOR_EMAIL=instructor@example.edu
INSTRUCTOR_PASSWORD=change-me-to-a-long-passphrase
# Random 32+ char string used to sign instructor cookies and hash student tokens
AUTH_SECRET=replace-with-a-long-random-string

# Public base URL used in QR codes (defaults to the request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000
